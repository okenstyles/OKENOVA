{
  "expo": {
    "name": "OKENOVΛ Native",
    "slug": "okenova-native",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "okenova-native",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.okenova.native",
      "supportsTablet": false
    },
    "android": {
      "package": "com.okenova.native",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/okenova-mark.png",
        "backgroundColor": "#090D19"
      }
    },
    "splash": {
      "image": "./assets/images/okenova-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#090D19"
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
