{
  "expo": {
    "name": "OKENOVΛ Native",
    "slug": "okenova-native",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "okenova-native",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.okenova.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "com.okenova.mobile",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/okenova-mark.png",
        "backgroundColor": "#090D19"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/okenova-mark.png",
          "imageWidth": 92,
          "resizeMode": "contain",
          "backgroundColor": "#090D19"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
